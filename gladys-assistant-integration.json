        {
          "key": "address",
          "type": "string",
          "label": {
            "en": "Address",
            "fr": "Adresse"
          },
          "description": {
            "en": "A free number from 0 to 255 (or A1 to P16), not used by another actuator of the same protocol.",
            "fr": "Un numéro libre de 0 à 255 (ou A1 à P16), non utilisé par un autre actionneur du même protocole."
          },
          "placeholder": {
            "en": "e.g. 1",
            "fr": "ex. 1"
          },
          "required": true
        },
        {
          "key": "qualifier",
          "type": "number",
          "label": {
            "en": "Qualifier (optional)",
            "fr": "Qualifier (optionnel)"
          },
          "description": {
            "en": "Protocol option. Somfy RTS: 1 for a gate, empty for a shutter.",
            "fr": "Option du protocole. Somfy RTS : 1 pour un portail, vide pour un volet."
          },
          "required": false,
          "min": 0,
          "max": 255
        },
        {
          "key": "send_pairing",
          "type": "boolean",
          "label": {
            "en": "Send the pairing frame",
            "fr": "Envoyer la trame d'appairage"
          },
          "description": {
            "en": "Untick to only declare a receiver already paired (or an X10 module).",
            "fr": "Décochez pour seulement déclarer un récepteur déjà appairé (ou un module X10)."
          },
          "required": false,
          "default": true
        }
      ]
    },
